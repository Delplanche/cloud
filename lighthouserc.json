{
  "ci": {
    "collect": {
      "startServerCommand": "bun run preview --port 4173",
      "startServerReadyPattern": "Local:",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://localhost:4173/en",
        "http://localhost:4173/en/stack",
        "http://localhost:4173/en/security",
        "http://localhost:4173/en/faq",
        "http://localhost:4173/en/gateway",
        "http://localhost:4173/en/cloud/vps",
        "http://localhost:4173/en/legal"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "mobile",
        "onlyCategories": ["performance", "accessibility", "seo", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "first-contentful-paint": ["error", { "maxNumericValue": 2000, "aggregationMethod": "median" }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median" }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300, "aggregationMethod": "median" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median" }],
        "speed-index": ["warn", { "maxNumericValue": 3400, "aggregationMethod": "median" }],
        "interactive": ["warn", { "maxNumericValue": 3800, "aggregationMethod": "median" }],
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:seo": ["error", { "minScore": 0.95, "aggregationMethod": "median" }],
        "categories:best-practices": ["warn", { "minScore": 0.95, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
